# Copy to .env (git-ignored) next to docker-compose.yml and set real host values.
# These point at directories OUTSIDE Git; never commit private keys or put them in an image.

# Mosquitto (broker) side. The directory must contain exactly:
#   ca.crt, server.crt, server.key
MQTT_BROKER_CERTS_DIR=/absolute/path/to/mosquitto-certs

# Backend (MQTT client) side. The directory must contain exactly:
#   ca.crt, client.crt, client.key
# It is mounted read-only into the backend container at /run/mqtt-certs.
MQTT_CLIENT_CERTS_DIR=/absolute/path/to/backend-client-certs

# Numeric GID of a dedicated host group that can read client.key. The backend container keeps
# its non-root `app` user (uid 100 / gid 101) and is given this group as a supplementary group
# (compose `group_add`), so it needs no change to the image and the key is not world-readable.
# Do not reuse another service's group; pick or create a dedicated one on the host.
MQTT_CLIENT_CERTS_GID=<numeric-gid-of-the-dedicated-cert-group>
#
# One-time host setup (run by the operator on the machine that holds the real certificates;
# replace the placeholders; this file does not do it for you):
#   sudo groupadd --system megh-mqtt-certs          # or use an existing dedicated group
#   getent group megh-mqtt-certs                     # -> the numeric GID to put above
#   sudo chgrp <that-group>  "$MQTT_CLIENT_CERTS_DIR" "$MQTT_CLIENT_CERTS_DIR"/client.key
#   sudo chmod 0750          "$MQTT_CLIENT_CERTS_DIR"          # group can enter the directory
#   sudo chmod 0640          "$MQTT_CLIENT_CERTS_DIR"/client.key   # group read, no world access
#   chmod 0644               "$MQTT_CLIENT_CERTS_DIR"/ca.crt "$MQTT_CLIENT_CERTS_DIR"/client.crt
# Verify without printing the key:  stat -c '%A %U:%G %n' "$MQTT_CLIENT_CERTS_DIR"/client.key
# Keep server.key / ca.key out of the client directory entirely.
